{
  "info": {
    "_postman_id": "ltz-content-service-v1",
    "name": "LTZ Content Service - Full API Collection",
    "description": "Lobby Two Zero — content-service için kapsamlı API test koleksiyonu.\n\nBase URL: http://localhost:8082\nGateway URL: http://localhost:8080\n\nAşağıdaki environment variable'ları ayarlayın:\n- BASE_URL: http://localhost:8082\n- GATEWAY_URL: http://localhost:8080\n- AUTH_TOKEN: <geçerli JWT token>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:8082", "type": "string" },
    { "key": "GATEWAY_URL", "value": "http://localhost:8080", "type": "string" },
    { "key": "AUTH_TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" }
  ],
  "item": [
    {
      "name": "🟢 Smoke Tests",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Status UP', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/actuator/health"
          }
        },
        {
          "name": "Swagger UI Erişilebilir",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Swagger UI 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/swagger-ui/index.html"
          }
        },
        {
          "name": "OpenAPI Docs Erişilebilir",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OpenAPI 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('OpenAPI JSON geçerli', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.openapi).to.exist;",
                  "  pm.expect(body.info).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/v3/api-docs"
          }
        }
      ]
    },
    {
      "name": "📰 News",
      "item": [
        {
          "name": "GET /api/content/news — Tüm Haberler (Sayfalı)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response body paginated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('content');",
                  "  pm.expect(body).to.have.property('totalElements');",
                  "  pm.expect(body).to.have.property('totalPages');",
                  "  pm.expect(body.content).to.be.an('array');",
                  "});",
                  "pm.test('Haber objesi doğru yapıda', () => {",
                  "  const body = pm.response.json();",
                  "  if (body.content.length > 0) {",
                  "    const news = body.content[0];",
                  "    pm.expect(news).to.have.property('id');",
                  "    pm.expect(news).to.have.property('title');",
                  "    pm.expect(news).to.have.property('reactions');",
                  "  }",
                  "});",
                  "// İlk haberin ID'sini kaydet",
                  "const body = pm.response.json();",
                  "if (body.content.length > 0) {",
                  "  pm.environment.set('FIRST_NEWS_ID', body.content[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/content/news?page=0&size=20",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ],
              "host": ["{{BASE_URL}}"],
              "path": ["api", "content", "news"]
            }
          }
        },
        {
          "name": "GET /api/content/news — Kategori Filtresi (GAMING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Haberler GAMING kategorisinde', () => {",
                  "  const body = pm.response.json();",
                  "  body.content.forEach(n => {",
                  "    pm.expect(n.category).to.eql('GAMING');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/content/news?category=GAMING",
              "query": [{ "key": "category", "value": "GAMING" }],
              "host": ["{{BASE_URL}}"],
              "path": ["api", "content", "news"]
            }
          }
        },
        {
          "name": "GET /api/content/news/:id — Haber Detayı",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Haber ID eşleşiyor', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.exist;",
                  "  pm.expect(body.reactions).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/content/news/{{FIRST_NEWS_ID}}"
          }
        },
        {
          "name": "GET /api/content/news/9999 — 404 Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/content/news/9999999"
          }
        }
      ]
    },
