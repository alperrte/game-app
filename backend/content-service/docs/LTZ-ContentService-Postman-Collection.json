    {
      "name": "🏔️ Spotlight (CMS)",
      "item": [
        {
          "name": "GET /api/content/spotlight — Aktif Banner'lar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Banner listesi döndü', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/content/spotlight"
          }
        },
        {
          "name": "POST /api/content/admin/spotlight — Banner Oluştur [ADMIN]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 veya 403', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('CREATED_BANNER_ID', body.id);",
                  "  pm.test('Banner oluşturuldu', () => {",
                  "    pm.expect(body.title).to.eql('Test Banner');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{AUTH_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Banner\",\n  \"subtitle\": \"Test Alt Başlık\",\n  \"imageUrl\": \"https://example.com/banner.jpg\",\n  \"targetUrl\": \"https://example.com\",\n  \"displayOrder\": 1,\n  \"active\": true\n}"
            },
            "url": "{{BASE_URL}}/api/content/admin/spotlight"
          }
        },
        {
          "name": "PUT /api/content/admin/spotlight/:id — Banner Güncelle [ADMIN]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 veya 403', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{AUTH_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Güncellenmiş Banner\",\n  \"subtitle\": \"Yeni Alt Başlık\",\n  \"imageUrl\": \"https://example.com/new-banner.jpg\",\n  \"targetUrl\": \"https://example.com/new\",\n  \"displayOrder\": 2,\n  \"active\": true\n}"
            },
            "url": "{{BASE_URL}}/api/content/admin/spotlight/{{CREATED_BANNER_ID}}"
          }
        },
        {
          "name": "DELETE /api/content/admin/spotlight/:id — Banner Sil [ADMIN]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 veya 403', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([204, 403]);",
