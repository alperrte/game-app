            "header": [
              { "key": "Authorization", "value": "Bearer {{AUTH_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/api/content/admin/spotlight/{{CREATED_BANNER_ID}}"
          }
        }
      ]
